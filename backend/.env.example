# Copy this file to .env (local) or set these as environment variables on Render.
# Real keys go ONLY in .env, never in this file.

# --- AI. Without a key the app still works (Verified lane only).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite
EMBED_MODEL=gemini-embedding-001

# --- Security: put any long random text here in production
JWT_SECRET=change-me-to-a-long-random-string

# --- Database. Leave empty for a local SQLite file.
# DATABASE_URL=postgresql://user:password@host/dbname

# --- Which websites may call this API (your Vercel URL). * allows all.
CORS_ORIGINS=*